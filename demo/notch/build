#!/bin/zsh
# builds ~/Friday/demo/notch/FridayNotch.app
set -e
cd ~/Friday/demo/notch
A=FridayNotch.app/Contents
mkdir -p $A/MacOS
swiftc -O main.swift -o $A/MacOS/FridayNotch -framework Cocoa -framework WebKit
cat > $A/Info.plist <<P
<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>com.friday.demonotch</string>
<key>CFBundleName</key><string>Friday Demo Notch</string>
<key>CFBundleExecutable</key><string>FridayNotch</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>LSUIElement</key><true/>
<key>NSAppTransportSecurity</key><dict><key>NSAllowsLocalNetworking</key><true/></dict>
</dict></plist>
P
codesign -s - --force FridayNotch.app
echo built
